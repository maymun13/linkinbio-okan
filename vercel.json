{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/liens", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:slug(x|X|tw|TW|twitter|Twitter|TWITTER)", "destination": "/api/go?slug=:slug" },
    { "source": "/stats", "destination": "/api/stats" }
  ]
}
